{
  "name": "packmatrix-desktop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "audit:npm": "npm audit --audit-level=high",
    "audit:cargo": "cargo audit --manifest-path src-tauri/Cargo.toml",
    "deny:cargo": "cargo-deny --manifest-path src-tauri/Cargo.toml check",
    "audit": "npm run audit:npm && npm run audit:cargo && npm run deny:cargo",
    "test": "node scripts/verify-zero-mock-data.mjs && node scripts/verify-e2e-workflows.mjs && node scripts/verify-chaos-resilience.mjs && node scripts/verify-airgap-packet-audit.mjs && node scripts/verify-code-signing.mjs && node scripts/verify-release-rollout.mjs && node scripts/verify-operations-and-salvage.mjs",
    "test:e2e": "playwright test",
    "verify:zero-mock": "node scripts/verify-zero-mock-data.mjs",
    "verify:workflows": "node scripts/verify-e2e-workflows.mjs",
    "verify:chaos": "node scripts/verify-chaos-resilience.mjs",
    "audit:airgap": "node scripts/verify-airgap-packet-audit.mjs",
    "verify:operations": "node scripts/verify-operations-and-salvage.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
