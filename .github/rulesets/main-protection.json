{
  "name": "SDLC Main Branch Protection & Cryptographic Integrity",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 2,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Gate 0.1 - Compiler & Runtime Lock-In Verification"
          },
          {
            "context": "Gate 0.2 - Supply Chain Security & Dependency Defense"
          },
          {
            "context": "Gate 0.3 - Code Quality, Security & Secret Scanning Gate"
          },
          {
            "context": "Gate 0.2 - Automated SBOM Generation (Syft)"
          }
        ]
      }
    }
  ]
}
