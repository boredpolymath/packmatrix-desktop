{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Defensive Tauri v2 Sandboxing and Scoped Permissions for PackMatrix Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:deny-read-file",
      "deny": [
        { "path": "/etc/**" },
        { "path": "/var/**" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*.delta.com/*" },
        { "url": "https://*.united.com/*" },
        { "url": "https://*.aa.com/*" },
        { "url": "https://*.ryanair.com/*" },
        { "url": "https://*.easyjet.com/*" },
        { "url": "https://*.lufthansa.com/*" },
        { "url": "https://*.airfrance.com/*" },
        { "url": "https://*.ba.com/*" },
        { "url": "https://*.singaporeair.com/*" },
        { "url": "https://*.ana.co.jp/*" },
        { "url": "https://*.emirates.com/*" },
        { "url": "https://*.qantas.com/*" },
        { "url": "https://*.tsa.gov/*" },
        { "url": "https://*.faa.gov/*" },
        { "url": "https://*.iata.org/*" }
      ]
    },
    "opener:deny-open-path"
  ]
}
